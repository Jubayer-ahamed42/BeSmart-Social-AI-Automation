# Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Page Credentials (Get from Meta Developer Portal)
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Optional Facebook App Credentials (for automatic token extension)
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here

# Optional Configurations (defaults to Asia/Dhaka)
TIMEZONE=Asia/Dhaka
